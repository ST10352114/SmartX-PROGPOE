@page "/ingestion"
@using System.ComponentModel.DataAnnotations
@implements IDisposable
@inject SmartXApiClient Api
@inject IngestionState State
@inject ToastService Toasts
@inject ILogger<Ingestion> Logger

<PageTitle>Sensor Data Ingestion and Telemetry</PageTitle>

<h1>Sensor Data Ingestion and Telemetry</h1>
<p class="lead">Register mesh sensors, ingest telemetry, attach files, and monitor live readings.</p>

<ApiStatusBanner Error="@State.LoadError" IsOffline="@State.IsOffline"
                 Hint="Live refresh keeps retrying every few seconds."
                 OnRetry="State.RefreshAsync" />

<LiveDashboard Sensors="State.Sensors" OpenIssueCount="State.OpenIssueCount" />
<AnomalySpotlightCard Sensors="State.Sensors" />

<div class="row g-4">
    <div class="col-12 col-lg-5">
        <div class="card h-100">
            <div class="card-header">Register a sensor</div>
            <div class="card-body">
                <EditForm Model="_registerForm" OnValidSubmit="RegisterSensorAsync">
                    <DataAnnotationsValidator />
                    <div class="mb-2">
                        <label class="form-label" for="sensorIdInput">Sensor ID (MAC / unique id)</label>
                        <InputText id="sensorIdInput" class="form-control" @bind-Value="_registerForm.SensorId" placeholder="AA:BB:CC:DD:EE:01" />
                        <ValidationMessage For="@(() => _registerForm.SensorId)" class="text-danger small" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label" for="deploymentNodeInput">Deployment node ID (location)</label>
                        <input id="deploymentNodeInput" class="form-control" list="knownDeploymentNodes" @bind="_registerForm.DeploymentNodeId" placeholder="e.g. NODE-A3-07" />
                        <datalist id="knownDeploymentNodes">
                            @foreach (var id in KnownDeploymentNodeIds)
                            {
                                <option value="@id"></option>
                            }
                        </datalist>
                        <ValidationMessage For="@(() => _registerForm.DeploymentNodeId)" class="text-danger small" />
                        <div class="form-text">Must match a node already configured in the gateway's deployment tree.</div>
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Category</label>
                        <InputSelect class="form-select" @bind-Value="_registerForm.Category">
                            <option value="@SensorCategory.Environmental">Environmental (float, %)</option>
                            <option value="@SensorCategory.PowerConsumption">Power consumption (int, W)</option>
                            <option value="@SensorCategory.Actuator">Actuator (bool, state)</option>
                        </InputSelect>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Display name (optional)</label>
                        <InputText class="form-control" @bind-Value="_registerForm.DisplayName" />
                    </div>
                    <button class="btn btn-primary" type="submit" disabled="@_registering">
                        @(_registering ? "Registering..." : "Register sensor")
                    </button>
                </EditForm>

                @if (_registerMessage is not null)
                {
                    <div class="alert @(_registerSuccess ? "alert-success" : "alert-danger") mt-3 py-2 mb-0">@_registerMessage</div>
                }
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-7">
        <div class="card h-100">
            <div class="card-header">Simulate telemetry</div>
            <div class="card-body">
                <p class="text-body-secondary">
                    No physical sensors are attached yet - use this to generate realistic-looking
                    readings (moisture %, wattage W, valve state) for every registered sensor, so
                    the table below has live data without real hardware.
                </p>
                <div class="d-flex gap-3 align-items-center flex-wrap">
                    <button class="btn btn-outline-primary" @onclick="State.GenerateOnceAsync" disabled="@(State.Sensors.Count == 0 || State.Generating)">
                        Generate one round now
                    </button>
                    <div class="form-check form-switch mb-0">
                        <input class="form-check-input" type="checkbox" id="autoSim" checked="@State.AutoSimulate" @onchange="OnAutoSimulateChanged" />
                        <label class="form-check-label" for="autoSim">Auto-generate every 5s</label>
                    </div>
                    @if (State.Generating)
                    {
                        <span class="text-body-secondary"><em>Posting readings&hellip;</em></span>
                    }
                </div>

                @if (State.SimulateError is not null)
                {
                    <div class="alert alert-warning mt-3 py-2 mb-0">@State.SimulateError</div>
                }
            </div>
        </div>
    </div>
</div>

<div class="card mt-4">
    <div class="card-header">Attach a file to a sensor</div>
    <div class="card-body">
        @if (State.Sensors.Count == 0)
        {
            <p class="text-body-secondary mb-0">Register a sensor first.</p>
        }
        else
        {
            <div class="row g-2 align-items-end mb-3">
                <div class="col-12 col-md-6">
                    <label class="form-label">Sensor</label>
                    <select class="form-select" @bind="_uploadSensorId" disabled="@_uploading">
                        @foreach (var sensor in State.Sensors)
                        {
                            <option value="@sensor.SensorId">@sensor.SensorId@(sensor.DisplayName is null ? "" : $" ({sensor.DisplayName})")</option>
                        }
                    </select>
                </div>
            </div>

            <label class="upload-dropzone @(_dragging ? "upload-dropzone--active" : "") @(_uploading ? "upload-dropzone--busy" : "")"
                   @ondragenter="@(() => _dragging = true)"
                   @ondragleave="@(() => _dragging = false)"
                   @ondragover:preventDefault="true">
                <InputFile OnChange="UploadProfileAsync"
                           @ondrop="@(() => _dragging = false)"
                           disabled="@_uploading"
                           class="upload-dropzone__input" />
                <span class="upload-dropzone__icon" aria-hidden="true">&#128194;</span>
                <span>
                    @if (_uploading)
                    {
                        <text>Uploading&hellip;</text>
                    }
                    else
                    {
                        <text>Drag a file here, or click to browse</text>
                    }
                </span>
                <span class="text-body-secondary small">Images (.png, .jpg), or .log / .txt / .json / .csv &mdash; up to 20&nbsp;MB</span>
            </label>

            @if (_uploading)
            {
                <div class="d-flex align-items-center gap-3 mt-3">
                    <div class="progress flex-grow-1" role="progressbar" aria-valuenow="@_uploadPercent" aria-valuemin="0" aria-valuemax="100" style="height: 0.75rem;">
                        <div class="progress-bar" style="width: @(_uploadPercent)%"></div>
                    </div>
                    <span class="text-body-secondary small" style="min-width: 3.5rem;">@_uploadPercent%</span>
                    <button type="button" class="btn btn-sm btn-outline-danger" @onclick="CancelUpload">Cancel</button>
                </div>
            }

            @if (_uploadMessage is not null)
            {
                <div class="alert @(_uploadSuccess ? "alert-success" : "alert-danger") mt-3 py-2 mb-0">@_uploadMessage</div>
            }
        }
    </div>
</div>

<IssuesPanel Sensors="State.Sensors" />

<div class="card mt-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>Registered sensors</span>
        <button class="btn btn-sm btn-outline-secondary" @onclick="State.RefreshAsync">Refresh</button>
    </div>
    <div class="card-body">
        @if (!State.HasLoadedOnce)
        {
            <div class="d-flex align-items-center gap-2 text-body-secondary">
                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                <span>Loading sensors&hellip;</span>
            </div>
        }
        else if (State.LoadError is not null && State.Sensors.Count == 0)
        {
            <p class="text-body-secondary mb-0"><em>Sensors can't be listed until the gateway responds.</em></p>
        }
        else if (State.Sensors.Count == 0)
        {
            <p class="text-body-secondary mb-0"><em>No sensors registered yet.</em></p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm table-striped align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Sensor ID</th>
                            <th>Location</th>
                            <th>Category</th>
                            <th>Display name</th>
                            <th>Latest reading</th>
                            <th>Change</th>
                            <th>Profile file</th>
                            <th>History</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var sensor in State.Sensors)
                        {
                            <tr>
                                <td>@sensor.SensorId</td>
                                <td>@sensor.DeploymentNodeId</td>
                                <td>@sensor.Category</td>
                                <td>@(sensor.DisplayName ?? "-")</td>
                                <td>
                                    @if (sensor.LatestReading is { } reading)
                                    {
                                        @($"{reading.FormattedValue} {reading.Unit}")
                                        <span class="text-body-secondary d-block small">@reading.Timestamp.ToLocalTime().ToString("HH:mm:ss")</span>
                                    }
                                    else
                                    {
                                        <span class="text-body-secondary"><em>No reading yet</em></span>
                                    }
                                </td>
                                <td>@FormatChange(sensor.LatestReading)</td>
                                <td>
                                    @if (sensor.Attachment is { } attachment)
                                    {
                                        <a href="@DownloadUrl(sensor.SensorId)" target="_blank" rel="noopener" title="@attachment.OriginalFileName">
                                            @Truncate(attachment.OriginalFileName, 18)
                                        </a>
                                        <span class="text-body-secondary d-block small">@FormatSize(attachment.SizeBytes)</span>
                                    }
                                    else
                                    {
                                        <span class="text-body-secondary">-</span>
                                    }
                                </td>
                                <td>
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => ToggleHistoryAsync(sensor.SensorId)">
                                        @(_expandedSensorId == sensor.SensorId ? "Hide" : "Show")
                                    </button>
                                </td>
                            </tr>
                            @if (_expandedSensorId == sensor.SensorId)
                            {
                                <tr>
                                    <td colspan="8" class="bg-body-tertiary">
                                        @if (_historyLoading)
                                        {
                                            <em class="text-body-secondary">Loading history&hellip;</em>
                                        }
                                        else if (_history.Count == 0)
                                        {
                                            <em class="text-body-secondary">No stored readings yet.</em>
                                        }
                                        else
                                        {
                                            <div class="d-flex flex-wrap gap-2 small">
                                                @foreach (var entry in _history)
                                                {
                                                    <span class="badge text-bg-light border fw-normal">
                                                        @entry.FormattedValue @entry.Unit
                                                        <span class="text-body-secondary">@entry.Timestamp.ToLocalTime().ToString("HH:mm:ss")</span>
                                                    </span>
                                                }
                                            </div>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@code {
    // Leaf nodes from the gateway's seeded deployment tree (SmartX.Api/Sensors/DeploymentSeed.cs).
    // Offered as datalist suggestions only - the API is the source of truth and
    // rejects anything that isn't actually in the tree.
    private static readonly string[] KnownDeploymentNodeIds = ["NODE-A3-07", "NODE-A3-08", "NODE-B1-01"];

    private readonly RegisterSensorForm _registerForm = new();

    private bool _registering;
    private bool _registerSuccess;
    private string? _registerMessage;

    private string? _uploadSensorId;
    private bool _uploading;
    private bool _uploadSuccess;
    private string? _uploadMessage;
    private int _uploadPercent;
    private bool _dragging;
    private CancellationTokenSource? _uploadCts;

    private string? _expandedSensorId;
    private bool _historyLoading;
    private List<TelemetryReadingDto> _history = [];

    protected override async Task OnInitializedAsync()
    {
        // Sensors, the live refresh and the auto-generate toggle live in the
        // scoped IngestionState, so returning to this page picks up where it
        // left off instead of starting from an empty list.
        State.Changed += OnStateChanged;
        try
        {
            await State.EnsureStartedAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Starting the ingestion live refresh failed.");
            Toasts.Show($"Live refresh couldn't start: {ex.Message}", ToastLevel.Danger);
        }

        _uploadSensorId ??= State.Sensors.FirstOrDefault()?.SensorId;
    }

    private void OnStateChanged()
    {
        _uploadSensorId ??= State.Sensors.FirstOrDefault()?.SensorId;
        InvokeAsync(StateHasChanged);
    }

    private async Task RegisterSensorAsync()
    {
        _registering = true;
        _registerMessage = null;
        try
        {
            var request = new RegisterSensorRequest(
                _registerForm.SensorId.Trim(),
                _registerForm.DeploymentNodeId.Trim(),
                _registerForm.Category,
                string.IsNullOrWhiteSpace(_registerForm.DisplayName) ? null : _registerForm.DisplayName.Trim());

            var result = await Api.RegisterSensorAsync(request);
            _registerSuccess = result.Success;
            _registerMessage = result.Success ? $"Registered '{request.SensorId}'." : result.Error;
            Toasts.Show(_registerMessage!, result.Success ? ToastLevel.Success : ToastLevel.Danger);

            if (result.Success)
            {
                _registerForm.Reset();
                await State.RefreshAsync();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Registering sensor '{SensorId}' failed.", _registerForm.SensorId);
            _registerSuccess = false;
            _registerMessage = $"Registration failed: {ex.Message}";
            Toasts.Show(_registerMessage, ToastLevel.Danger);
        }
        finally
        {
            _registering = false;
        }
    }

    private void OnAutoSimulateChanged(ChangeEventArgs e)
    {
        try
        {
            State.SetAutoSimulate(e.Value is true);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Toggling auto-generate failed.");
            Toasts.Show($"Couldn't change auto-generate: {ex.Message}", ToastLevel.Danger);
        }
    }

    private async Task UploadProfileAsync(InputFileChangeEventArgs args)
    {
        if (_uploadSensorId is null)
        {
            return;
        }

        _uploading = true;
        _uploadPercent = 0;
        _uploadMessage = null;
        _uploadCts = new CancellationTokenSource();

        try
        {
            var result = await Api.UploadProfileAsync(
                _uploadSensorId,
                args.File,
                onProgress: bytesSent => InvokeAsync(() =>
                {
                    _uploadPercent = args.File.Size == 0 ? 100 : (int)(bytesSent * 100 / args.File.Size);
                    StateHasChanged();
                }),
                _uploadCts.Token);

            _uploadSuccess = result.Success;
            _uploadMessage = result.Success ? $"Attached '{args.File.Name}' to '{_uploadSensorId}'." : result.Error;
            Toasts.Show(_uploadMessage!, result.Success ? ToastLevel.Success : ToastLevel.Danger);

            if (result.Success)
            {
                await State.RefreshAsync();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Uploading '{FileName}' failed.", args.File.Name);
            _uploadSuccess = false;
            _uploadMessage = $"Upload failed: {ex.Message}";
            Toasts.Show(_uploadMessage, ToastLevel.Danger);
        }
        finally
        {
            _uploading = false;
            _uploadCts?.Dispose();
            _uploadCts = null;
        }
    }

    private void CancelUpload() => _uploadCts?.Cancel();

    private string DownloadUrl(string sensorId) => new Uri(Api.BaseAddress, $"api/sensors/{Uri.EscapeDataString(sensorId)}/profile").ToString();

    private static string Truncate(string value, int maxLength)
        => value.Length <= maxLength ? value : string.Concat(value.AsSpan(0, maxLength - 1), "…");

    private static string FormatSize(long bytes) => bytes switch
    {
        < 1024 => $"{bytes} B",
        < 1024 * 1024 => $"{bytes / 1024.0:0.#} KB",
        _ => $"{bytes / (1024.0 * 1024):0.#} MB",
    };

    private async Task ToggleHistoryAsync(string sensorId)
    {
        if (_expandedSensorId == sensorId)
        {
            _expandedSensorId = null;
            _history = [];
            return;
        }

        _expandedSensorId = sensorId;
        _historyLoading = true;
        _history = [];
        try
        {
            _history = await Api.GetSensorHistoryAsync(sensorId);
        }
        catch (ApiException ex)
        {
            _expandedSensorId = null;
            Toasts.Show(ex.Message, ex.IsOffline ? ToastLevel.Danger : ToastLevel.Warning);
        }
        catch (Exception ex)
        {
            _expandedSensorId = null;
            Logger.LogError(ex, "Loading history for {SensorId} failed.", sensorId);
            Toasts.Show($"Couldn't load history for {sensorId}: {ex.Message}", ToastLevel.Danger);
        }
        finally
        {
            _historyLoading = false;
        }
    }

    /// <summary>
    /// "Change since last reading" - <c>reading.ChangeSinceLast</c> is
    /// <c>current - previous</c> via <c>SensorReading operator -</c>, computed
    /// server-side in <c>SensorRepository.SubmitReading</c>.
    /// </summary>
    private static string FormatChange(TelemetryReadingDto? reading)
    {
        if (reading?.ChangeSinceLast is not { } change)
        {
            return "-";
        }

        var sign = change > 0 ? "+" : "";
        return $"{sign}{change:0.#} {reading.Unit}";
    }

    public void Dispose()
    {
        // Only unsubscribe: the refresh and auto-generate loops belong to
        // IngestionState and keep running while the user is on another page.
        State.Changed -= OnStateChanged;
        _uploadCts?.Cancel();
    }

    private sealed class RegisterSensorForm
    {
        [Required]
        public string SensorId { get; set; } = "";

        [Required]
        public string DeploymentNodeId { get; set; } = "";

        public SensorCategory Category { get; set; } = SensorCategory.Environmental;

        public string? DisplayName { get; set; }

        public void Reset()
        {
            SensorId = "";
            DeploymentNodeId = "";
            Category = SensorCategory.Environmental;
            DisplayName = null;
        }
    }
}
