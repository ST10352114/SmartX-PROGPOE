@page "/"
@inject NavigationManager Nav
@inject SmartXOne.Client.Services.SmartXApiClient Api
@inject ILogger<Home> Logger

<PageTitle>Smart-X Gateway</PageTitle>

<h1>Smart-X Data Ingestion and Validation Gateway</h1>
<p class="lead">
    A simulated IoT mesh ecosystem for monitoring distributed environments.
    Pick a feature below to get started.
</p>

<div class="row g-3 mt-1">
    @foreach (var item in FeatureMenu.Items)
    {
        <div class="col-12 col-md-6 col-xl-4">
            <div class="card h-100 border-primary">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title mb-2">@item.Title</h5>
                    <p class="card-text flex-grow-1 text-body-secondary">@item.Description</p>
                    <button class="btn btn-primary mt-2" @onclick="() => Nav.NavigateTo(item.Href)">
                        Open
                    </button>
                </div>
            </div>
        </div>
    }
</div>

<hr class="my-4" />

<h2 class="h5">Gateway connectivity</h2>
@if (_error is not null)
{
    <ApiStatusBanner Error="@_error" IsOffline="@_offline"
                     Hint="The dashboards still open, but show no live data until the gateway is running."
                     OnRetry="LoadAsync" />
}
else if (_info is null)
{
    <p class="text-body-secondary"><em>Contacting the gateway&hellip;</em></p>
}
else
{
    <p class="text-success mb-0">
        &#10003; @_info.Message
        <span class="text-body-secondary">
            (@_info.Service, v@_info.Version, @_info.Environment,
            server @_info.ServerTimeUtc.ToString("u"))
        </span>
    </p>
}

@code {
    private GatewayInfo? _info;
    private string? _error;
    private bool _offline;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _error = null;
        _offline = false;
        _info = null;
        try
        {
            _info = await Api.GetGatewayInfoAsync();
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
            _offline = ex.IsOffline;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Loading gateway info failed.");
            _error = $"Couldn't read the gateway status: {ex.Message}";
        }
    }
}
